# Copy to `.env.local` for local development, or set in Vercel Project Settings → Environment Variables.

# The production URL of the site. Set this once you know your Vercel URL or
# custom domain (e.g. https://jayavel.dev or https://portfolio.vercel.app).
# If unset, the app falls back to Vercel's own VERCEL_URL/VERCEL_PROJECT_PRODUCTION_URL
# at build/runtime, so this is optional but recommended once you have a stable domain.
NEXT_PUBLIC_SITE_URL=

# Optional, privacy-conscious analytics (Plausible). Leave blank to keep
# analytics fully disabled — the site works identically either way.
# See README.md "Analytics" section for setup instructions.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
